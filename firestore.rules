rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Top-level user profile: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Allow create/update only if the user owns the document and does not tamper with someone else's UID
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && (
        !('uid' in request.resource.data) || request.resource.data.uid == userId
      );
      allow delete: if false; // Profiles should not be arbitrarily deleted by client

      // Subcollection: Activity Events
      // users/{userId}/activity/{activityId}
      match /activity/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.eventType is string;
        allow update, delete: if false; // Append-only audit trail
      }

      // Subcollection: Search History
      // users/{userId}/searchHistory/{searchId}
      match /searchHistory/{searchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.query is string;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Movie Interaction History
      // users/{userId}/movieInteractions/{interactionId}
      match /movieInteractions/{interactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.action is string;
        allow update, delete: if false; // Append-only interaction log
      }

      // Subcollection: Recommendation History
      // users/{userId}/recommendationHistory/{recommendationId}
      match /recommendationHistory/{recommendationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.recommendationSessionId is string;
        allow update, delete: if false; // Append-only recommendation logs
      }

      // Subcollection: Watchlist
      // users/{userId}/watchlist/{movieId}
      match /watchlist/{movieId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Favorites / Ratings / Reviews
      // users/{userId}/favorites/{movieId}
      match /favorites/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /ratings/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /reviews/{movieId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Preferences
      // users/{userId}/preferences/{prefDoc}
      match /preferences/{prefDoc} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
